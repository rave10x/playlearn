{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Playlearn",
  "version": "1.7.1",
  "identifier": "com.rahul1015s.playlearn",
  "build": { "frontendDist": "../renderer" },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "Education",
    "shortDescription": "YouTube playlists as Udemy-style courses",
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
